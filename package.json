{
  "name": "kigalimarket-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && prisma generate",
    "preview": "vite preview",
    "server": "tsx server/src/index.ts",
    "start": "prisma migrate deploy && tsx server/src/index.ts",
    "test": "vitest run",
    "prisma:generate": "npx prisma generate",
    "prisma:db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:test:init": "tsx scripts/test-db.ts init",
    "db:test:start": "tsx scripts/test-db.ts start",
    "db:test:stop": "tsx scripts/test-db.ts stop",
    "db:test:status": "tsx scripts/test-db.ts status",
    "dev:api": "tsx scripts/test-db.ts start && dotenv -e .env.local -- tsx server/src/index.ts",
    "dev:seed": "tsx scripts/test-db.ts start && dotenv -e .env.local -- tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/supertest": "^6.0.2",
    "autoprefixer": "^10.5.4",
    "dotenv-cli": "^11.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.5.26",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.112.2",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "gsap": "^3.12.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "prisma": "^5.22.0",
    "split-type": "^0.3.4",
    "tsx": "^4.19.2",
    "vite": "^4.5.0",
    "zod": "^3.23.8"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.18.20": true,
    "prisma@5.22.0": true
  }
}
