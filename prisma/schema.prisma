datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NOTE: SQLite has no native enum type, and Prisma's enum feature requires a
// connector that supports it (Postgres/MySQL) - the "enum" blocks that used to
// live here failed schema validation the moment anyone ran `prisma generate`
// against this sqlite datasource. Every enum below has been replaced with a
// plain String field constrained by convention (documented per-field) instead.

// 1. Administrator Model
model Administrator {
  id               String             @id @default(uuid())
  email            String             @unique
  passwordHash     String
  name             String
  role             String             @default("ADMINISTRATOR") // "ADMINISTRATOR" | "SUB_ADMINISTRATOR"
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  lastLoginAt      DateTime?
  createdSubAdmins SubAdministrator[] @relation("AdminCreatedSubAdmin")
}

// 2. SubAdministrator Model
model SubAdministrator {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        @default("SUB_ADMINISTRATOR")
  permissions  String        // JSON array of assigned module permissions, e.g. ["PRODUCTS","SELLERS"]
  createdById  String
  createdBy    Administrator @relation("AdminCreatedSubAdmin", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?
}

// 3. PlatformUser Model (Distinct from Seller)
model PlatformUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  status       String    @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  roles        String    @default("[\"USER\"]") // JSON array of user roles
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
}

// 4. Seller Model
model Seller {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  businessName String
  contactPhone String?
  district     String?
  status       String    @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  products     Product[]
}

// 5. Category Model
model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  iconUrl   String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// 6. Product Model
model Product {
  id            String   @id @default(uuid())
  title         String
  description   String
  price         Float
  currency      String   @default("RWF")
  district      String   @default("Gasabo")
  condition     String   @default("New")
  images        String   @default("[]") // JSON array of image URLs
  sellerId      String
  seller        Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  status        String   @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  isFeatured    Boolean  @default(false)
  isTrending    Boolean  @default(false)
  isRecommended Boolean  @default(false)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 7. Advertisement Model
model Advertisement {
  id        String   @id @default(uuid())
  title     String
  type      String   // "HOMEPAGE_BANNER" | "HERO_SLIDER" | "PROMOTIONAL_BANNER"
  imageUrl  String
  targetUrl String?
  startDate DateTime
  endDate   DateTime
  status    String   @default("SCHEDULED") // "SCHEDULED" | "ACTIVE" | "EXPIRED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 8. AuditLog Model
// Note: actorId is intentionally NOT a foreign key. Actors can be an Administrator,
// SubAdministrator, Seller, or the system itself ("SYSTEM") - there is no single
// actors table to reference, so actorType is the discriminator instead.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actorName String   @default("")
  actorType String   // "ADMINISTRATOR" | "SUB_ADMINISTRATOR" | "SELLER" | "SYSTEM"
  action    String   // e.g. "SUSPEND_SELLER", "CREATE_PRODUCT"
  module    String   // e.g. "SELLERS", "PRODUCTS"
  targetId  String?
  details   String?  // JSON string of change diff/metadata
  ipAddress String?
  createdAt DateTime @default(now())
}

// 9. RealEstateContent Model (Gasabo Real Estate CMS)
model RealEstateContent {
  id         String   @id @default(uuid())
  sectionKey String   @unique // e.g. "HERO", "ABOUT", "SERVICES", "PROJECTS", "GALLERY", "CONTACT"
  content    String   // JSON formatted content object
  updatedAt  DateTime @updatedAt
}

// 10. Notification Model
model Notification {
  id            String   @id @default(uuid())
  recipientType String   // "SELLER" | "ADMIN"
  recipientId   String?  // Seller ID or Admin ID (null for all admins)
  type          String   // e.g. "EXPIRY_WARNING", "SUSPENSION", "NEW_SELLER_REGISTRATION"
  message       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// 11. Approval Request Model (Multi-Admin Dual Authorization Workflow)
model ApprovalRequest {
  id                String    @id @default(uuid())
  actionType        String    // e.g. "DELETE_SELLER_ACCOUNT", "DELETE_CATEGORY", "CHANGE_ADMIN_PERMISSIONS"
  targetName        String
  targetId          String?
  requestedById     String
  requestedByName   String
  requestedByEmail  String
  reason            String
  status            String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  riskLevel         String    @default("HIGH")     // "LOW" | "MEDIUM" | "HIGH"
  requiredRole      String    @default("ADMINISTRATOR")
  approvedByName    String?
  approvalDate      DateTime?
  rejectedByName    String?
  rejectionDate     DateTime?
  note              String?
  createdAt         DateTime  @default(now())
}
