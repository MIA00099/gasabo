# Copy to .env.test to enable the destructive test suite.
#
# WARNING: `npm test` DELETES EVERY ROW IN EVERY TABLE of whatever database
# this points at. It must be a scratch database you are happy to lose -
# a separate Supabase project, or a local Postgres instance.
#
# It must NOT be the DATABASE_URL from .env (that is production). The guard
# in server/test/setup.ts refuses to run if the two match.
#
# Note the schema is PostgreSQL (not SQLite, despite what README.md says -
# that text predates the Supabase migration), so a `file:./dev.db` style
# SQLite URL will not work here.

DATABASE_URL="postgresql://postgres:password@localhost:5432/kigalimarket_test"
DIRECT_URL="postgresql://postgres:password@localhost:5432/kigalimarket_test"

# Explicit opt-in. The suite will not run without this set to exactly "yes".
ALLOW_DESTRUCTIVE_DB_TESTS=yes

JWT_SECRET="test_only_secret_not_used_in_production_environments"
NODE_ENV="test"

# After creating .env.test, apply the schema to the scratch DB once:
#   npx dotenv -e .env.test -- prisma migrate deploy
