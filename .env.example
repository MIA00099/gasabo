DATABASE_URL="postgresql://postgres:password@localhost:5433/kigalimarket_dev"
DIRECT_URL="postgresql://postgres:password@localhost:5433/kigalimarket_dev"
PORT=3001
JWT_SECRET="replace-with-at-least-32-random-characters"
NODE_ENV="development"
PUBLIC_SITE_URL="http://localhost:5173"
# Optional comma-separated allowlist. Development allows any origin when unset;
# production defaults to PUBLIC_SITE_URL when unset.
# CORS_ORIGIN="https://www.kigalimarket.com,https://kigalimarket.com"
# Optional. When omitted, uploads are written to server/uploads/.
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Where "Contact Us" submissions and their email notifications go. Also the
# address shown across the marketplace/support pages. Defaults to the value
# below when unset.
# CONTACT_EMAIL="kigalimarket20@gmail.com"

# Optional outbound SMTP for the contact-form email notification. When any of
# HOST/USER/PASS is missing the server logs the message instead of sending it
# (a fresh checkout needs none of this). Example: a Gmail account + app password.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="kigalimarket20@gmail.com"
# SMTP_PASS="your-gmail-app-password"
# SMTP_FROM="Kigali Market <kigalimarket20@gmail.com>"
